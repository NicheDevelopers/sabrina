{
  "name": "sabrina",
  "version": "0.0.0",
  "private": true,
  "description": "Discord music bot that plays audio from YouTube",
  "keywords": [
    "bot",
    "discord",
    "music",
    "youtube"
  ],
  "license": "MIT",
  "author": "NicheDevs",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vpx --watch src/main.ts",
    "build": "vp pack",
    "start": "node dist/main.js",
    "test": "vp test",
    "check": "vp check",
    "docker:build": "docker build -t sabrina:latest .",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
