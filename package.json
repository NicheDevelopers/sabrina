{
  "name": "sabrina",
  "version": "1.1.3",
  "description": "Discord music bot that plays audio from YouTube",
  "keywords": [
    "bot",
    "discord",
    "music",
    "youtube"
  ],
  "license": "MIT",
  "author": "NicheDevs",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vpx --watch src/main.ts",
    "build": "vp pack",
    "start": "node dist/main.js",
    "test": "vp test",
    "check": "vp check",
    "docker:build": "docker build -t sabrina:latest .",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.6",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.15",
    "@types/yt-search": "^2.10.3",
    "typescript": "^5.6.3",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
